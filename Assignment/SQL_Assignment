1.	Find employees whose salary increased every month.

select emp_id
	from (
		select 
			emp_id,
			month,
			salary,
			LAG(salary) OVER (PARTITION BY emp_id ORDER BY month) AS prev_salary
			FROm emp_salary
	) T
	GROUP By emp_id
	HAVING MIN(salary-prev_salary)>0;

